@echo off
chcp 65001 >nul
echo ========================================
echo     ПОЛНАЯ ПРОВЕРКА ПРОЕКТА
echo     OOP Shop Engine
echo ========================================
echo.

echo ========================================
echo 1. Проверка Poetry
echo ========================================
poetry --version
echo.

echo ========================================
echo 2. Информация о виртуальном окружении
echo ========================================
poetry env info
echo.

echo ========================================
echo 3. Установка зависимостей
echo ========================================
poetry install --no-root
echo.

echo ========================================
echo 4. Проверка линтером Ruff
echo ========================================
poetry run ruff check src/
echo.

echo ========================================
echo 5. Проверка форматирования Black
echo ========================================
poetry run black src/ tests/ --check
echo.

echo ========================================
echo 6. Запуск основной программы
echo ========================================
poetry run python main.py
echo.

echo ========================================
echo 7. Запуск всех тестов
echo ========================================
poetry run pytest tests/ -v
echo.

echo ========================================
echo 8. Запуск тестов с покрытием
echo ========================================
poetry run pytest --cov=src --cov-report=term tests/
echo.

echo ========================================
echo 9. Создание HTML отчета о покрытии
echo ========================================
poetry run pytest --cov=src --cov-report=html tests/
echo.

echo ========================================
echo 10. Проверка создания отчета
echo ========================================
if exist htmlcov (
    echo [OK] Отчет создан в папке htmlcov/
    echo [OK] Откройте htmlcov/index.html в браузере
    dir htmlcov\*.html
) else (
    echo [ERROR] Отчет не создан!
)
echo.

echo ========================================
echo     ПРОВЕРКА ЗАВЕРШЕНА УСПЕШНО!
echo ========================================
echo.
echo Все проверки пройдены! Вы можете сдавать проект.
echo.
pause